# Device credentials belong in .env.local; never in the web renderer.
AEROSENSE_API_URL=https://aerosense.me/api
AEROBOT_DEVICE_ID=
AEROBOT_DEVICE_KEY=
# Leave both credentials empty for local demonstration. No commands are claimed.
AEROBOT_OPEN_WINDOW=1
AEROBOT_IR_PORT=
# Optional Wibowo fallback. Set the Python executable in the prepared virtual environment.
AEROBOT_TTS_PYTHON=
# Use URL and key instead to connect to a separately started local service.
AEROBOT_LOCAL_TTS_URL=
AEROBOT_LOCAL_TTS_KEY=
