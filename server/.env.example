PORT=8080
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_SECRET
DEVICE_KEYS_JSON={}
WEB_ORIGINS=https://YOUR_DASHBOARD_DOMAIN
WEB_ROBOT_ID=

# Optional until WhatsApp is connected. Gemini and WhatsApp sending use n8n credentials.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TEMPLATE=aerosense_alert
WHATSAPP_TEMPLATE_LANGUAGE=id

# GOWA prototype transport. setup-gowa.sh generates credentials on Ubuntu.
# Keep meta until migration 010 is applied and the aerosense device is linked.
WHATSAPP_PROVIDER=meta
GOWA_BASE_URL=http://aerosense-gowa:3000
GOWA_DEVICE_ID=aerosense
GOWA_DEVICE_JID=
GOWA_BASIC_AUTH=
GOWA_WEBHOOK_SECRET=

# Public disaster feeds refresh every 15 minutes. Apply migration 005 first.
DISASTER_NEWS_ENABLED=true

# Laptop microphone transcription and speaker output. Keep these server-side.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
